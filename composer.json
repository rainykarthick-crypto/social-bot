{
    "name": "social-bot/lead-bot",
    "description": "Social media lead bot + multi-account publisher + Krayin CRM orchestration (PHP 8.3, MySQL 8, Redis 6).",
    "type": "project",
    "license": "MIT",
    "keywords": [
        "deepseek",
        "crm",
        "krayin",
        "mixpost",
        "lead-generation",
        "social-media"
    ],
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "guzzlehttp/guzzle": "^7.9",
        "vlucas/phpdotenv": "^5.6",
        "illuminate/database": "^11.0",
        "illuminate/events": "^11.0",
        "symfony/messenger": "^6.4 || ^7.0",
        "deepseek-php/deepseek-php-client": "^2.1",
        "jbuncle/php-vadersentiment": "^1.0",
        "amirsarhang/instagram-php-sdk": "^4.0",
        "atymic/twitter": "^3.0",
        "googleads/google-ads-php": "^27.0"
    },
    "autoload": {
        "psr-4": {
            "SocialBot\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "scripts": {
        "lint": "@php tools/lint.php",
        "migrate": "@php migrate.php",
        "smoke": "@php tests/smoke.php",
        "worker": "@php worker.php --daemon",
        "audit": "@php audit.php",
        "digest": "@php digest.php",
        "serve": "@php -S 127.0.0.1:8080 -t public public/router.php"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
