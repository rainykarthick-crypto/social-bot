# ---------------------------------------------------------------------------
# Social Bot - environment template.  Copy to `.env` and fill in real values.
#   cp .env.example .env
# Nothing here is sent anywhere until you fill it in; the app degrades to the
# local Ollama fallback and "credentials pending" stubs when a key is missing.
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
APP_NAME="social-bot"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Kolkata

# --- App logging ------------------------------------------------------------
# debug|info|notice|warning|error|critical
APP_LOG_LEVEL=debug

# --- Primary LLM: DeepSeek --------------------------------------------------
# Leave empty to force the Ollama fallback (nothing breaks, quality drops).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Transport for the LLM calls: "http" (built-in Guzzle client, default, exposes
# token/cache usage) or "sdk" (deepseek-php/deepseek-php-client).
DEEPSEEK_TRANSPORT=http
# DeepSeek V4 model ids.  V4_FLASH is used for every classification/routing
# call; V4_PRO is only used when thinking mode is explicitly requested.
DEEPSEEK_MODEL_FAST=deepseek-v4-flash
DEEPSEEK_MODEL_REASONING=deepseek-v4-pro
DEEPSEEK_TIMEOUT=60
DEEPSEEK_MAX_TOKENS=400
DEEPSEEK_BATCH_SIZE=15
# Hard daily ceiling on completion+prompt tokens; over budget -> Ollama.
DEEPSEEK_DAILY_TOKEN_BUDGET=2000000

# Cost estimate inputs for llm_usage.cost_estimate (USD per 1M tokens).
DEEPSEEK_PRICE_IN=0.28
DEEPSEEK_PRICE_CACHED_IN=0.028
DEEPSEEK_PRICE_OUT=0.42

# --- Local LLM fallback: Ollama --------------------------------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=120

# --- MySQL 8 ----------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=social_bot
DB_USER=bot
DB_PASS=secret
DB_CHARSET=utf8mb4
DB_PREFIX=

# --- Redis 6 (cache / rate-limit / dedupe) ---------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Krayin CRM (central hub) ----------------------------------------------
KRAYIN_API_URL=http://localhost/krayin/public
KRAYIN_API_TOKEN=
KRAYIN_DEFAULT_APPROVER_ID=1
KRAYIN_DEFAULT_USER_ID=1
KRAYIN_PIPELINE_ID=1
KRAYIN_WEBHOOK_SECRET=

# --- Mixpost Lite (multi-account publisher) --------------------------------
MIXPOST_URL=http://localhost/mixpost
# Path prefix of the Mixpost API inside the Laravel app.
MIXPOST_API_PREFIX=/mixpost/api
MIXPOST_API_TOKEN=
MIXPOST_WORKSPACE_UUID=
MIXPOST_TIMEZONE=Asia/Kolkata

# --- Meta (Facebook + Instagram webhooks) ----------------------------------
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0

# --- Instagram Graph --------------------------------------------------------
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# graph.facebook.com (Facebook Login tokens) or graph.instagram.com (Instagram Login tokens)
INSTAGRAM_GRAPH_BASE=https://graph.facebook.com

# --- Google Ads lead form webhooks ----------------------------------------
GOOGLE_ADS_WEBHOOK_KEY=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Twitter / X (atymic/twitter) -----------------------------------------
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=

# --- WhatsApp Cloud API ----------------------------------------------------
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# --- Social listening agent (audit.php --listen) ---------------------------
# Comma separated brand/product keywords to track in every ingested comment.
LISTENING_KEYWORDS=
LISTENING_MAX_POSTS=10
LISTENING_LOOKBACK_HOURS=24

# --- Evergreen recycler (audit.php --evergreen) ----------------------------
EVERGREEN_MIN_AGE_DAYS=30
EVERGREEN_MIN_LEADS=1
EVERGREEN_MAX_PER_RUN=3

# --- Publishing / approval workflow ---------------------------------------
# Maps a logical platform to the Mixpost account id used for publishing.
PLATFORM_ACCOUNT_MAP={"instagram":1,"linkedin":2,"twitter":3,"facebook":4}
# Hours before an unanswered approval level is marked sla_breached.
APPROVAL_SLA_HOURS=24

# --- Dashboard --------------------------------------------------------------
DASHBOARD_USER=
DASHBOARD_PASS=
DASHBOARD_PAGE_SIZE=50
# Port the bundled native runner (tools/local-stack.ps1) serves on.
WEB_PORT=8081

# --- Daily digest email -----------------------------------------------------
DIGEST_TO=
DIGEST_FROM=bot@localhost
DIGEST_SUBJECT="Social Bot daily digest"

# --- Worker ----------------------------------------------------------------
WORKER_BATCH_SIZE=20
WORKER_SLEEP_SECONDS=5
# true => only spend LLM tokens inside the off-peak windows below.
WORKER_OFFPEAK_ONLY=false
# UTC windows, comma separated, "start-end" (wraps past midnight when start>end).
DEEPSEEK_OFFPEAK_WINDOWS=04:00-06:00,10:00-01:00
DEEPSEEK_OFFPEAK_ALL_WEEKEND=true
