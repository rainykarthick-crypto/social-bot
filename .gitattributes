# Normalise line endings: LF in the repository, whatever the platform uses locally.
* text=auto eol=lf

*.php   text eol=lf
*.sql   text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.txt   text eol=lf
*.sh    text eol=lf

# Windows-only helpers keep CRLF so they run from cmd.exe/PowerShell.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binaries / generated content must never be line-ending converted.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.zip   binary
*.vhdx  binary

# Runtime output is not tracked at all.
storage/** -text
*.log      -text

# Keep diffs readable for the large generated lock file.
composer.lock -diff linguist-generated
